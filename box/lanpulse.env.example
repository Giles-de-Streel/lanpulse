# lanpulse collector settings. Copied to /opt/monitor/lanpulse.env by setup.sh on first run.

# How often to build a snapshot (seconds)
LANPULSE_INTERVAL=30

# Override the title/description from the Uptime Kuma status page (optional)
LANPULSE_SITE_NAME=
LANPULSE_SITE_DESC=

# Where the data comes from (comma-separated). Built in: uptime-kuma, netcheck, router
LANPULSE_SOURCES=uptime-kuma,netcheck,router
KUMA_STATUS_SLUG=dashboard

# Extra publishers besides the local file (comma-separated): http, gist
# Leave empty for local only.
LANPULSE_PUBLISHERS=

# --- http: PUT/POST the snapshot to any URL (WebDAV/Nextcloud, S3/R2 presigned URL, webhook)
PUBLISH_HTTP_URL=
PUBLISH_HTTP_METHOD=PUT
PUBLISH_HTTP_AUTH=

# --- gist: update snapshot.json in a GitHub Gist (token needs only the "gist" scope)
# Read back from https://gist.githubusercontent.com/<user>/<GIST_ID>/raw/snapshot.json
GIST_ID=
GIST_TOKEN=

# --- router: connection type (wired / 2.4 / 5 / 6 GHz), access point, signal and backhaul.
# Types: asus (stock firmware incl. AiMesh/ZenWiFi, experimental), openwrt (ubus/LuCI), unifi,
# tmobile (T-Mobile Home Internet gateways; ROUTER_URL=http://192.168.12.1, user admin)
# (UniFi OS console or classic controller). Leave ROUTER_TYPE empty to skip.
# Use a dedicated or read-only account where the router supports one. This file is root-only (600).
ROUTER_TYPE=
ROUTER_URL=                # e.g. http://192.168.1.1  (several OpenWrt APs: comma-separated)
ROUTER_USER=
ROUTER_PASS=
ROUTER_SITE=default        # UniFi site name
ROUTER_VERIFY_TLS=0        # 0 accepts the self-signed certificates most routers use
ROUTER_INTERVAL=300        # seconds between router logins (ASUS allows few web sessions)
ROUTER_WEAK_RSSI=-70       # backhaul/client signal below this (dBm) is flagged

# --- netcheck (runs on the host every 10 min; set any to 0 to turn it off)
NETCHECK_DHCP=1            # rogue DHCP servers
NETCHECK_DHCP_EXPECTED=    # allowed DHCP server IPs (default: the gateway)
NETCHECK_NAT=1             # double NAT / carrier NAT
NETCHECK_UPNP=1            # ports opened to the internet by devices
NETCHECK_LOSS=1            # packet loss and jitter to router and internet
NETCHECK_DNS=1             # DNS response time
NETCHECK_DNS_SERVER=       # default: the gateway
NETCHECK_PUBLICIP=1        # public IP lookup via api.ipify.org (the only outside call)
NETCHECK_AIRSPACE=1        # Wi-Fi survey with the box's Wi-Fi adapter
NETCHECK_OWN_SSIDS=        # your network names, comma-separated (default: the one the box is joined to)
NETCHECK_DEVICES=1         # device summary from NetAlertX
NETCHECK_UPLINK=1          # internet uplink quality from the modem/gateway, when it publishes it (T-Mobile Home Internet)
NETCHECK_UPLINK_HOST=      # default: the gateway
NETCHECK_SPEED=1           # speed trend from Speedtest Tracker (flags two tests in a row well below normal)
NETCHECK_SPEED_DROP_PCT=50 # "well below" = this % under the 14-day median
NETCHECK_NEIGHBOUR_DBM=-80 # neighbouring Wi-Fi weaker than this is ignored for overlap
NETCHECK_BUSY_PCT=60       # (legacy) airtime % considered busy
