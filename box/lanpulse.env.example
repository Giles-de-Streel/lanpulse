# lanpulse collector settings. Copied to /opt/monitor/lanpulse.env by setup.sh on first run.

# How often to build a snapshot (seconds)
LANPULSE_INTERVAL=30

# Override the title/description from the Uptime Kuma status page (optional)
LANPULSE_SITE_NAME=
LANPULSE_SITE_DESC=

# Where the data comes from (comma-separated). Built in: uptime-kuma
LANPULSE_SOURCES=uptime-kuma
KUMA_STATUS_SLUG=dashboard

# Extra publishers besides the local file (comma-separated): http, gist
# Leave empty for local only.
LANPULSE_PUBLISHERS=

# --- http: PUT/POST the snapshot to any URL (WebDAV/Nextcloud, S3/R2 presigned URL, webhook)
PUBLISH_HTTP_URL=
PUBLISH_HTTP_METHOD=PUT
PUBLISH_HTTP_AUTH=

# --- gist: update snapshot.json in a GitHub Gist (token needs only the "gist" scope)
# Read back from https://gist.githubusercontent.com/<user>/<GIST_ID>/raw/snapshot.json
GIST_ID=
GIST_TOKEN=
