:80 {
	encode gzip

	# settings API (router login etc.): local network only, never cached
	handle /api/* {
		@outside not remote_ip private_ranges
		respond @outside "Settings can only be changed from the local network" 403
		header Cache-Control "no-store"
		reverse_proxy lanpulse-collector:8081
	}

	handle /data/* {
		root * /srv
		header Cache-Control "no-store"
		header Access-Control-Allow-Origin "*"
		file_server
	}

	handle {
		# page files: browsers revalidate each load (cheap 304s), so updates always show
		header Cache-Control "no-cache"
		root * /srv/www
		file_server
	}
}
